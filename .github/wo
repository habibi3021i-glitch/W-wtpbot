name: W-Bot07

on:
  push:
    branches: [main]
  workflow_dispatch:
  schedule:
    - cron: '0 */5 * * *'

# Only one bot may run at a time (two copies = "Bad MAC" errors)
concurrency:
  group: wbot07
  cancel-in-progress: true

permissions:
  contents: write

env:
  GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
  GH_REPO: ${{ github.repository }}

jobs:
  bot:
    runs-on: ubuntu-latest
    timeout-minutes: 350
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Wait for previous run to save its session
        run: sleep 25

      - name: Restore WhatsApp session (from private 'session' branch)
        run: |
          git clone --quiet --branch session --single-branch \
            "https://x-access-token:${GH_TOKEN}@github.com/${GH_REPO}.git" session_bot \
            || mkdir -p session_bot
          echo "Session files restored: $(ls session_bot | wc -l)"

      - name: Install Dependencies
        run: npm install

      - name: Create session saver script
        run: |
          cat > "$RUNNER_TEMP/save.sh" << 'EOS'
          #!/bin/bash
          cd "$GITHUB_WORKSPACE/session_bot" || exit 0
          [ -f creds.json ] || exit 0
          if [ ! -d .git ]; then
            git init -q -b session
            git remote add origin "https://x-access-token:${GH_TOKEN}@github.com/${GH_REPO}.git"
          fi
          git config user.name "wbot"
          git config user.email "wbot@users.noreply.github.com"
          git add -A
          git diff --cached --quiet && exit 0
          git commit -q -m "session $(date -u +%FT%TZ)"
          git push -q -f origin session
          echo "Session saved"
          EOS
          chmod +x "$RUNNER_TEMP/save.sh"

      - name: Start Restaurant WhatsApp Bot
        timeout-minutes: 335
        run: |
          ( while true; do sleep 240; "$RUNNER_TEMP/save.sh" || true; done ) &
          npm start

      - name: Save session (final)
        if: always()
        run: |
          "$RUNNER_TEMP/save.sh" || true
